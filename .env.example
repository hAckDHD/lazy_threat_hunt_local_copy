# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Turso/libSQL (required on Vercel/serverless — get from turso.tech).
# Leave empty to use a local SQLite file under IOC_DATA_DIR (default ~/.ioc-tool).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
IOC_DATA_DIR=

# ── Access control ──────────────────────────────────────────────────────────
# Strongly recommended for any deployment reachable by others.
# Generate: openssl rand -hex 32
IOC_API_TOKEN=

# CORS — set to your own deployment origin (e.g. https://your-app.vercel.app).
# Leave empty to block all cross-origin requests.
IOC_ALLOWED_ORIGIN=

# ── Local server ────────────────────────────────────────────────────────────
# Bind address. Defaults to loopback only. Use 0.0.0.0 to expose on your
# network (set IOC_API_TOKEN first).
IOC_HOST=127.0.0.1
IOC_PORT=8847

# Set to 1 only if running behind a reverse proxy that overwrites
# X-Forwarded-For / X-Real-IP (Vercel is detected automatically).
IOC_TRUST_PROXY=

# ── Optional enrichment API keys ────────────────────────────────────────────
# Server-side keys are only used when the instance is private (IOC_API_TOKEN
# set, or bound to loopback). Set IOC_SHARE_SERVER_KEYS=1 to let anonymous
# visitors of a public deployment spend them.
VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
IOC_SHARE_SERVER_KEYS=
